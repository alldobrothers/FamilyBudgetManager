@inject FamilyBudget.Application.Interfaces.ICurrentFamilyContext CurrentFamilyContext
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Family Budget Manager</title>
    
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Bootstrap & Custom CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true && CurrentFamilyContext.CurrentFamily != null)
    {
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
        <div class="app-wrapper">
            <!-- Sidebar -->
            <aside class="app-sidebar" id="appSidebar">
                <div class="sidebar-header">
                    <a asp-controller="Dashboard" asp-action="Index" class="brand-logo">
                        <div class="brand-icon">
                            <i class="bi bi-wallet2"></i>
                        </div>
                        <div>
                            <span>FamilyBudget</span>
                            <span class="badge bg-primary-subtle text-primary ms-1" style="font-size: 0.65rem;">PRO</span>
                        </div>
                    </a>
                </div>

                <div class="sidebar-body">
                    <!-- Household Switcher -->
                    <div class="px-2 mb-3">
                        <div class="dropdown">
                            <button class="btn btn-outline-secondary w-100 text-start d-flex align-items-center justify-content-between p-2 rounded-3" 
                                    type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.85rem;">
                                <div class="d-flex align-items-center gap-2 text-truncate">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 0.75rem;">
                                        <i class="bi bi-house-door-fill"></i>
                                    </div>
                                    <span class="fw-semibold text-truncate">@CurrentFamilyContext.CurrentFamily.Name</span>
                                </div>
                                <i class="bi bi-chevron-expand text-muted"></i>
                            </button>
                            <ul class="dropdown-menu shadow w-100 p-2 border-0">
                                <li class="dropdown-header text-uppercase" style="font-size: 0.7rem;">Your Households</li>
                                @if (ViewBag.UserFamilies is List<FamilyBudget.Domain.Entities.Family> families && families.Any())
                                {
                                    @foreach (var fam in families)
                                    {
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center justify-content-between rounded-2 py-2 @(fam.Id == CurrentFamilyContext.CurrentFamilyId ? "active" : "")" 
                                               asp-controller="Family" asp-action="Switch" asp-route-familyId="@fam.Id">
                                                <span>@fam.Name</span>
                                                @if (fam.Id == CurrentFamilyContext.CurrentFamilyId)
                                                {
                                                    <i class="bi bi-check2"></i>
                                                }
                                            </a>
                                        </li>
                                    }
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-primary d-flex align-items-center gap-2 py-2" asp-controller="Family" asp-action="Onboarding">
                                        <i class="bi bi-plus-circle"></i> Create New Household
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="sidebar-section-title">Core Finance</div>
                    <a asp-controller="Dashboard" asp-action="Index" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                        <i class="bi bi-grid-1x2-fill"></i>
                        <span>Dashboard</span>
                    </a>
                    <a asp-controller="Expenses" asp-action="Index" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Expenses" ? "active" : "")">
                        <i class="bi bi-arrow-down-circle-fill"></i>
                        <span>Expenses</span>
                    </a>
                    <a asp-controller="Income" asp-action="Index" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Income" ? "active" : "")">
                        <i class="bi bi-arrow-up-circle-fill"></i>
                        <span>Income</span>
                    </a>
                    <a asp-controller="Budgets" asp-action="Index" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Budgets" ? "active" : "")">
                        <i class="bi bi-pie-chart-fill"></i>
                        <span>Monthly Budget</span>
                    </a>

                    <div class="sidebar-section-title">Obligations & Bills</div>
                    <a asp-controller="RecurringBills" asp-action="Index" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "RecurringBills" ? "active" : "")">
                        <i class="bi bi-receipt-cutoff"></i>
                        <span>Recurring Bills</span>
                    </a>
                    <a asp-controller="Debts" asp-action="Index" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Debts" ? "active" : "")">
                        <i class="bi bi-bank2"></i>
                        <span>Debts & Loans</span>
                    </a>
                    <a asp-controller="Obligations" asp-action="Index" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Obligations" ? "active" : "")">
                        <i class="bi bi-clock-history"></i>
                        <span>Obligations</span>
                    </a>

                    <div class="sidebar-section-title">Insights & Admin</div>
                    <a asp-controller="Reports" asp-action="Index" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")">
                        <i class="bi bi-file-earmark-bar-graph-fill"></i>
                        <span>Reports & Export</span>
                    </a>
                    <a asp-controller="Family" asp-action="Members" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Family" && ViewContext.RouteData.Values["action"]?.ToString() == "Members" ? "active" : "")">
                        <i class="bi bi-people-fill"></i>
                        <span>Members</span>
                    </a>
                    <a asp-controller="Family" asp-action="Settings" class="nav-item-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Family" && ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")">
                        <i class="bi bi-gear-fill"></i>
                        <span>Household Settings</span>
                    </a>
                </div>

                <div class="p-3 border-top d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-indigo text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; font-weight: 700; background-color: var(--brand-primary);">
                            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </div>
                        <div class="text-truncate" style="max-width: 130px;">
                            <div class="fw-semibold text-truncate" style="font-size: 0.82rem;">@User.Identity.Name</div>
                            <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.65rem;">@CurrentFamilyContext.CurrentRole</span>
                        </div>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Sign Out">
                            <i class="bi bi-box-arrow-right fs-5"></i>
                        </button>
                    </form>
                </div>
            </aside>

            <!-- Main Panel -->
            <div class="app-main">
                <!-- Top Navbar -->
                <header class="app-navbar">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-outline-secondary d-lg-none" id="sidebarToggle" type="button">
                            <i class="bi bi-list fs-5"></i>
                        </button>
                        <div>
                            <h5 class="mb-0 fw-bold">@ViewData["Title"]</h5>
                            <span class="text-muted" style="font-size: 0.8rem;">Household: <strong>@CurrentFamilyContext.CurrentFamily.Name</strong> (@(CurrentFamilyContext.CurrentFamily.CurrencySymbol) @(CurrentFamilyContext.CurrentFamily.CurrencyCode))</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <!-- Theme Toggle -->
                        <button class="btn btn-outline-secondary btn-sm rounded-circle d-flex align-items-center justify-content-center" id="themeToggleBtn" style="width: 36px; height: 36px;" title="Toggle Dark/Light Mode">
                            <i class="bi bi-moon-stars" id="themeIcon"></i>
                        </button>

                        <!-- Notifications Bell -->
                        <a asp-controller="Notifications" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle position-relative d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;" title="Notifications">
                            <i class="bi bi-bell"></i>
                            @if (ViewBag.UnreadNotificationCount is int unread && unread > 0)
                            {
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                                    @unread
                                </span>
                            }
                        </a>

                        <!-- Quick Add Action -->
                        <div class="dropdown ms-1">
                            <button class="btn btn-primary-custom btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-plus-lg"></i> Quick Action
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2">
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Expenses" asp-action="Create">
                                        <i class="bi bi-arrow-down-circle text-danger"></i> Record Expense
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Income" asp-action="Create">
                                        <i class="bi bi-arrow-up-circle text-success"></i> Record Income
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="RecurringBills" asp-action="Create">
                                        <i class="bi bi-receipt text-primary"></i> Add Recurring Bill
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Debts" asp-action="Create">
                                        <i class="bi bi-bank text-warning"></i> Record Debt / Loan
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <!-- Profile Dropdown -->
                        <div class="dropdown ms-1">
                            <button class="btn btn-outline-secondary btn-sm rounded-circle d-flex align-items-center justify-content-center" 
                                    style="width: 36px; height: 36px;" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-2">
                                <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-gear me-2"></i>My Profile</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Family" asp-action="Members"><i class="bi bi-people me-2"></i>Household Members</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Family" asp-action="Settings"><i class="bi bi-sliders me-2"></i>Settings</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger py-2">
                                            <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- Page Body -->
                <main class="app-content">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <div>@TempData["SuccessMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <div>@TempData["ErrorMessage"]</div>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <!-- Public / Non-household pages (Login, Register, Onboarding) -->
        <main class="min-vh-100 d-flex flex-column justify-content-center py-5 bg-app">
            <div class="container">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show max-w-md mx-auto shadow-sm mb-4" role="alert" style="max-width: 500px;">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show max-w-md mx-auto shadow-sm mb-4" role="alert" style="max-width: 500px;">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </main>
    }

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Dark / Light Mode Sync
        const currentTheme = localStorage.getItem('fb_theme') || 'light';
        document.documentElement.setAttribute('data-bs-theme', currentTheme);
        updateThemeIcon(currentTheme);

        document.getElementById('themeToggleBtn')?.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-bs-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-bs-theme', next);
            localStorage.setItem('fb_theme', next);
            updateThemeIcon(next);
        });

        function updateThemeIcon(theme) {
            const icon = document.getElementById('themeIcon');
            if (!icon) return;
            if (theme === 'dark') {
                icon.className = 'bi bi-sun-fill text-warning';
            } else {
                icon.className = 'bi bi-moon-stars text-secondary';
            }
        }

        // Mobile Sidebar Toggle
        const sidebar = document.getElementById('appSidebar');
        const backdrop = document.getElementById('sidebarBackdrop');
        const toggleBtn = document.getElementById('sidebarToggle');

        toggleBtn?.addEventListener('click', () => {
            sidebar?.classList.toggle('show');
            backdrop?.classList.toggle('show');
        });

        backdrop?.addEventListener('click', () => {
            sidebar?.classList.remove('show');
            backdrop?.classList.remove('show');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model FamilyBudget.Web.Models.MarkBillPaidViewModel
@{
    ViewData["Title"] = "Settle Bill Payment";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card glass-card border-0 p-4">
            <h4 class="fw-bold mb-1">Settle Bill Payment</h4>
            <p class="text-muted small mb-4">
                Confirm payment for: <strong>@Model.Occurrence?.BillTemplate?.BillName</strong> (Due: @Model.Occurrence?.DueDate.ToString("MMM dd, yyyy"))
            </p>

            <form asp-action="MarkPaid" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="OccurrenceId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="ActualAmountPaid" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent text-muted">@Model.CurrencySymbol</span>
                            <input asp-for="ActualAmountPaid" type="number" step="0.01" class="form-control" autofocus />
                        </div>
                        <span asp-validation-for="ActualAmountPaid" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PaidDate" class="form-label"></label>
                        <input asp-for="PaidDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="PaidByMemberId" class="form-label"></label>
                        <select asp-for="PaidByMemberId" class="form-select">
                            @foreach (var m in Model.Members)
                            {
                                <option value="@m.Id">@m.User?.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PaymentMethod" class="form-label"></label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="UPI">UPI / GPay / PhonePe</option>
                            <option value="Credit Card">Credit Card</option>
                            <option value="Debit Card">Debit Card</option>
                            <option value="Net Banking">Net Banking</option>
                            <option value="Cash">Cash</option>
                        </select>
                    </div>
                </div>

                <div class="form-check form-switch p-3 bg-light rounded-3 border mb-3">
                    <input asp-for="CreateExpenseEntry" class="form-check-input ms-0 me-2" type="checkbox" id="expenseEntrySwitch" />
                    <label class="form-check-label fw-bold" for="expenseEntrySwitch">
                        Automatically record this payment as a household expense
                    </label>
                    <div class="form-text small">Recommended: This will automatically update your monthly expenses and category charts without double entry.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Confirmation code, transaction notes..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary-custom">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="bi bi-check2-circle"></i> Settle Bill
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

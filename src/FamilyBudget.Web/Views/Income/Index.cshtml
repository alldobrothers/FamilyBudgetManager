@model FamilyBudget.Web.Models.IncomeListViewModel
@{
    ViewData["Title"] = "Household Income";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Household Inflows & Income</h3>
        <p class="text-muted mb-0">Total recorded this period: <strong class="text-success">@Model.CurrencySymbol@Model.TotalFilteredAmount.ToString("N2")</strong></p>
    </div>
    <a asp-action="Create" class="btn btn-primary-custom">
        <i class="bi bi-plus-lg"></i> Record Income
    </a>
</div>

<!-- Filter Bar -->
<div class="card glass-card border-0 p-3 mb-4">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <input type="text" name="SearchTerm" class="form-control form-control-sm" placeholder="Search source or title..." />
        </div>
        <div class="col-md-3">
            <select name="MemberId" class="form-select form-select-sm">
                <option value="">All Recipients</option>
                @foreach (var m in Model.Members)
                {
                    <option value="@m.Id" selected="@(m.Id == Model.SelectedMemberId)">@m.User?.DisplayName</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="month" class="form-select form-select-sm">
                @for (int m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(m == (Model.SelectedMonth ?? DateTime.UtcNow.Month))">@(new DateTime(2000, m, 1).ToString("MMM"))</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-secondary-custom btn-sm flex-grow-1">
                <i class="bi bi-funnel"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Clear Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Income Table -->
<div class="card glass-card border-0 mb-4 overflow-hidden">
    @if (Model.Incomes.Any())
    {
        <div class="table-responsive">
            <table class="table table-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th>Title / Source</th>
                        <th>Category</th>
                        <th>Recipient Member</th>
                        <th>Date Received</th>
                        <th>Method</th>
                        <th>Type</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inc in Model.Incomes)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-success-subtle text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                        <i class="bi bi-arrow-up-circle"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold">@inc.Title</div>
                                        <div class="text-muted small">@inc.IncomeSource</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <span class="category-dot" style="background-color: @(inc.Category?.ColorHex ?? "#10b981")"></span>
                                    @(inc.Category?.Name ?? "General Income")
                                </span>
                            </td>
                            <td><span class="text-muted small">@(inc.RecipientMember?.User?.DisplayName ?? inc.RecipientMember?.User?.FullName ?? "Household")</span></td>
                            <td><span class="text-muted small">@inc.DateReceived.ToString("MMM dd, yyyy")</span></td>
                            <td><span class="badge bg-secondary-subtle text-secondary small">@inc.PaymentMethod</span></td>
                            <td>
                                @if (inc.IsRecurring)
                                {
                                    <span class="badge bg-info-subtle text-info"><i class="bi bi-repeat"></i> Recurring</span>
                                }
                                else
                                {
                                    <span class="text-muted small">One-time</span>
                                }
                            </td>
                            <td class="text-end fw-bold text-success">+@Model.CurrencySymbol@inc.Amount.ToString("N2")</td>
                            <td class="text-end">
                                <form asp-action="Delete" asp-route-id="@inc.Id" method="post" onsubmit="return confirm('Delete this income entry?');" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-wallet2 fs-1 mb-2"></i>
            <div>No income recorded for this period.</div>
            <div class="mt-3"><a asp-action="Create" class="btn btn-primary-custom btn-sm">Record New Income</a></div>
        </div>
    }
</div>

@model FamilyBudget.Web.Models.RecordRepaymentViewModel
@{
    ViewData["Title"] = "Record Debt Repayment";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card glass-card border-0 p-4">
            <h4 class="fw-bold mb-1">Record Repayment</h4>
            <p class="text-muted small mb-4">
                Record payment towards: <strong>@Model.Debt?.CreditorOrDebtorName</strong> (Current Balance: @Model.CurrencySymbol@Model.Debt?.CurrentBalance.ToString("N2"))
            </p>

            <form asp-action="Repay" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="DebtId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Amount" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent text-muted">@Model.CurrencySymbol</span>
                            <input asp-for="Amount" type="number" step="0.01" class="form-control" autofocus />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PaymentDate" class="form-label"></label>
                        <input asp-for="PaymentDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="RepaidByMemberId" class="form-label"></label>
                        <select asp-for="RepaidByMemberId" class="form-select">
                            @foreach (var m in Model.Members)
                            {
                                <option value="@m.Id">@m.User?.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PaymentMethod" class="form-label"></label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="UPI">UPI / GPay / PhonePe</option>
                            <option value="Bank Transfer">Bank Transfer / NEFT</option>
                            <option value="Cash">Cash</option>
                            <option value="Cheque">Cheque</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ReferenceNumber" class="form-label"></label>
                    <input asp-for="ReferenceNumber" class="form-control" placeholder="Transaction ID, UTR, Cheque # (Optional)" />
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Repayment comments..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary-custom">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="bi bi-check2"></i> Submit Repayment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

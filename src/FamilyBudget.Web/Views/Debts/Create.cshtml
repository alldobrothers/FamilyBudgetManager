@model FamilyBudget.Web.Models.CreateDebtViewModel
@{
    ViewData["Title"] = "Record Debt / Loan";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card glass-card border-0 p-4">
            <h4 class="fw-bold mb-1">Record Debt or Loan</h4>
            <p class="text-muted small mb-4">Track money your household borrowed or lent to others</p>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="DebtType" class="form-label"></label>
                    <div class="d-flex gap-4 p-2 bg-light rounded-3 border">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="DebtType" value="Borrowed" id="typeBorrowed" checked>
                            <label class="form-check-label fw-semibold text-danger" for="typeBorrowed">
                                <i class="bi bi-box-arrow-in-down-left"></i> Borrowed (Liability - We owe money)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" asp-for="DebtType" value="Lent" id="typeLent">
                            <label class="form-check-label fw-semibold text-success" for="typeLent">
                                <i class="bi bi-box-arrow-up-right"></i> Lent (Receivable - Someone owes us)
                            </label>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-7">
                        <label asp-for="CreditorOrDebtorName" class="form-label"></label>
                        <input asp-for="CreditorOrDebtorName" class="form-control" placeholder="e.g. HDFC Bank, Uncle Rajesh, Car Financing" autofocus />
                        <span asp-validation-for="CreditorOrDebtorName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="OriginalPrincipal" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent text-muted">@Model.CurrencySymbol</span>
                            <input asp-for="OriginalPrincipal" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="OriginalPrincipal" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="LinkedMemberId" class="form-label"></label>
                        <select asp-for="LinkedMemberId" class="form-select">
                            <option value="">-- Household Shared --</option>
                            @foreach (var m in Model.Members)
                            {
                                <option value="@m.Id">@m.User?.FullName</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label"></label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="InterestRate" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="InterestRate" type="number" step="0.01" class="form-control" placeholder="0" />
                            <span class="input-group-text">% p.a.</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="DueDate" class="form-label"></label>
                        <input asp-for="DueDate" type="date" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="InstallmentAmount" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent text-muted">@Model.CurrencySymbol</span>
                            <input asp-for="InstallmentAmount" type="number" step="0.01" class="form-control" placeholder="Monthly EMI" />
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Loan account number, terms, collateral notes..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary-custom">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="bi bi-save"></i> Save Debt Record
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

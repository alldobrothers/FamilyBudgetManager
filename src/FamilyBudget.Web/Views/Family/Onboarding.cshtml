@model FamilyBudget.Web.Models.CreateFamilyViewModel
@{
    ViewData["Title"] = "Household Setup";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="text-center mb-4">
            <div class="brand-icon mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.7rem;">
                <i class="bi bi-house-add"></i>
            </div>
            <h3 class="fw-bold">Create Your Household</h3>
            <p class="text-muted">A household allows all family members to track shared income, expenses, debts, and budgets collaboratively.</p>
        </div>

        <div class="card glass-card border-0 p-4 mb-4">
            <form asp-controller="Family" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Sharma Family, 402 Palm Residency" autofocus />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="CurrencySymbol" class="form-label"></label>
                        <input asp-for="CurrencySymbol" class="form-control" placeholder="₹ or $ or €" />
                        <span asp-validation-for="CurrencySymbol" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CurrencyCode" class="form-label"></label>
                        <select asp-for="CurrencyCode" class="form-select">
                            <option value="INR">INR (₹ Indian Rupee)</option>
                            <option value="USD">USD ($ US Dollar)</option>
                            <option value="EUR">EUR (€ Euro)</option>
                            <option value="GBP">GBP (£ British Pound)</option>
                            <option value="AED">AED (د.إ UAE Dirham)</option>
                            <option value="CAD">CAD ($ Canadian Dollar)</option>
                            <option value="AUD">AUD ($ Australian Dollar)</option>
                        </select>
                        <span asp-validation-for="CurrencyCode" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="MonthlyBudget" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent text-muted">₹</span>
                        <input asp-for="MonthlyBudget" type="number" step="0.01" class="form-control" placeholder="e.g. 75000" />
                    </div>
                    <div class="form-text small">Planned overall target for monthly household expenses. Can be adjusted anytime.</div>
                    <span asp-validation-for="MonthlyBudget" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2" placeholder="Brief note or address..."></textarea>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 justify-content-center py-2">
                    <i class="bi bi-check-circle"></i> Create Household & Enter
                </button>
            </form>
        </div>

        <div class="card bg-surface border rounded-3 p-3 text-center shadow-sm">
            <span class="text-muted small">Were you invited by another family member?</span>
            <span class="small mt-1 text-secondary">Click the invitation link sent to your email to join their household.</span>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

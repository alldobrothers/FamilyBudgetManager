@model List<FamilyBudget.Domain.Entities.ExpenseTransaction>
@{
    ViewData["Title"] = "Pending Expense Approvals";
    var currencySymbol = ViewBag.CurrencySymbol as string ?? "₹";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Pending Expense Approvals</h3>
        <p class="text-muted mb-0">Review and authorize member expenditures requiring approval</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary-custom">
        <i class="bi bi-arrow-left"></i> Back to Expenses
    </a>
</div>

<div class="card glass-card border-0 overflow-hidden">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th>Expense</th>
                        <th>Category</th>
                        <th>Submitted By</th>
                        <th>Date</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var exp in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@exp.Title</div>
                                @if (!string.IsNullOrWhiteSpace(exp.MerchantOrShop))
                                {
                                    <div class="text-muted small">@exp.MerchantOrShop</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@(exp.Category?.Name ?? "Uncategorized")</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                        @(exp.PaidByMember?.User?.DisplayName?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <span class="small fw-semibold">@(exp.PaidByMember?.User?.FullName ?? "Member")</span>
                                </div>
                            </td>
                            <td><span class="text-muted small">@exp.ExpenseDate.ToString("MMM dd, yyyy")</span></td>
                            <td class="text-end fw-bold text-danger">@currencySymbol@exp.Amount.ToString("N2")</td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <form asp-action="Approve" asp-route-id="@exp.Id" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success d-flex align-items-center gap-1">
                                            <i class="bi bi-check2"></i> Approve
                                        </button>
                                    </form>
                                    <form asp-action="Reject" asp-route-id="@exp.Id" method="post" class="m-0" onsubmit="return confirm('Reject this expense?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1">
                                            <i class="bi bi-x"></i> Reject
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-check2-circle text-success fs-1 mb-2"></i>
            <div>All member expenses are up to date and approved!</div>
        </div>
    }
</div>

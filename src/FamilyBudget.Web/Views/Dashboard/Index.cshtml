@model FamilyBudget.Application.DTOs.DashboardSummaryDto
@{
    ViewData["Title"] = "Household Dashboard";
    int currentYear = ViewBag.SelectedYear ?? DateTime.UtcNow.Year;
    int currentMonth = ViewBag.SelectedMonth ?? DateTime.UtcNow.Month;
}

<!-- Dashboard Header & Period Filter -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Financial Overview</h3>
        <p class="text-muted mb-0">Summary for <strong>@(new DateTime(currentYear, currentMonth, 1).ToString("MMMM yyyy"))</strong></p>
    </div>

    <!-- Month & Year Selector Form -->
    <form asp-controller="Dashboard" asp-action="Index" method="get" class="d-flex align-items-center gap-2">
        <select name="month" class="form-select form-select-sm" style="width: 140px;">
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(m == currentMonth)">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
            }
        </select>
        <select name="year" class="form-select form-select-sm" style="width: 100px;">
            @for (int y = DateTime.UtcNow.Year - 2; y <= DateTime.UtcNow.Year + 1; y++)
            {
                <option value="@y" selected="@(y == currentYear)">@y</option>
            }
        </select>
        <button type="submit" class="btn btn-secondary-custom btn-sm">
            <i class="bi bi-filter"></i> Apply
        </button>
    </form>
</div>

<!-- Alerts Section -->
@if (Model.Alerts.Any())
{
    @foreach (var alert in Model.Alerts)
    {
        <div class="alert alert-@(alert.Type) d-flex align-items-center justify-content-between shadow-sm mb-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi @(alert.Type == "danger" ? "bi-exclamation-octagon-fill" : "bi-exclamation-triangle-fill") fs-4"></i>
                <div>
                    <strong>@alert.Title</strong> @alert.Message
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(alert.ActionUrl))
            {
                <a href="@alert.ActionUrl" class="btn btn-sm btn-outline-@(alert.Type)">@alert.ActionText</a>
            }
        </div>
    }
}

<!-- KPI Cards Grid (8 Core Financial Metrics) -->
<div class="row g-3 mb-4">
    <!-- 1. Total Income -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Total Income</div>
                    <div class="stat-value text-success">@Model.CurrencySymbol@Model.TotalIncome.ToString("N2")</div>
                </div>
                <div class="stat-icon income">
                    <i class="bi bi-arrow-up-circle-fill"></i>
                </div>
            </div>
            <div class="text-muted small mt-2">
                Inflows this month
            </div>
        </div>
    </div>

    <!-- 2. Total Expenses -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Total Expenses</div>
                    <div class="stat-value text-danger">@Model.CurrencySymbol@Model.TotalExpenses.ToString("N2")</div>
                </div>
                <div class="stat-icon expense">
                    <i class="bi bi-arrow-down-circle-fill"></i>
                </div>
            </div>
            <div class="text-muted small mt-2">
                Confirmed household outflows
            </div>
        </div>
    </div>

    <!-- 3. Net Cash Flow -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Net Cash Flow</div>
                    <div class="stat-value @(Model.NetCashFlow >= 0 ? "text-primary" : "text-danger")">
                        @Model.CurrencySymbol@Model.NetCashFlow.ToString("N2")
                    </div>
                </div>
                <div class="stat-icon balance">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
            <div class="text-muted small mt-2">
                @(Model.NetCashFlow >= 0 ? "Surplus retained" : "Net household deficit")
            </div>
        </div>
    </div>

    <!-- 4. Remaining Budget -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Remaining Budget</div>
                    <div class="stat-value">@Model.CurrencySymbol@Model.RemainingBudget.ToString("N2")</div>
                </div>
                <div class="stat-icon" style="background: rgba(99, 102, 241, 0.15); color: #6366f1;">
                    <i class="bi bi-pie-chart-fill"></i>
                </div>
            </div>
            <div class="progress progress-budget mt-2">
                <div class="progress-bar @(Model.BudgetUtilizationPercentage >= 90 ? "bg-danger" : (Model.BudgetUtilizationPercentage >= 75 ? "bg-warning" : "bg-primary"))" 
                     role="progressbar" 
                     style="width: @Math.Min(100, Model.BudgetUtilizationPercentage)%"></div>
            </div>
            <div class="text-muted small mt-1 d-flex justify-content-between">
                <span>@Model.BudgetUtilizationPercentage% Spent</span>
                <span>Target: @Model.CurrencySymbol@Model.TotalBudget.ToString("N0")</span>
            </div>
        </div>
    </div>

    <!-- 5. Outstanding Debt -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Borrowed Liabilities</div>
                    <div class="stat-value text-warning">@Model.CurrencySymbol@Model.OutstandingDebt.ToString("N2")</div>
                </div>
                <div class="stat-icon debt">
                    <i class="bi bi-bank2"></i>
                </div>
            </div>
            <div class="text-muted small mt-2">
                <a asp-controller="Debts" asp-action="Index" class="text-decoration-none small text-warning fw-semibold">View repayments &rarr;</a>
            </div>
        </div>
    </div>

    <!-- 6. Upcoming Bills -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Upcoming Bills</div>
                    <div class="stat-value text-info">@Model.CurrencySymbol@Model.UpcomingBillsTotal.ToString("N2")</div>
                </div>
                <div class="stat-icon" style="background: rgba(6, 182, 212, 0.15); color: #06b6d4;">
                    <i class="bi bi-receipt-cutoff"></i>
                </div>
            </div>
            <div class="text-muted small mt-2">
                <a asp-controller="RecurringBills" asp-action="Index" class="text-decoration-none small text-info fw-semibold">@Model.UpcomingBillsList.Count dues &rarr;</a>
            </div>
        </div>
    </div>

    <!-- 7. Pending Obligations -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Pending Obligations</div>
                    <div class="stat-value" style="color: #8b5cf6;">@Model.CurrencySymbol@Model.PendingPaymentsTotal.ToString("N2")</div>
                </div>
                <div class="stat-icon" style="background: rgba(139, 92, 246, 0.15); color: #8b5cf6;">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
            <div class="text-muted small mt-2">
                <a asp-controller="Obligations" asp-action="Index" class="text-decoration-none small fw-semibold" style="color: #8b5cf6;">Track liabilities &rarr;</a>
            </div>
        </div>
    </div>

    <!-- 8. Available Cash Estimate -->
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Liquid Liquidity Est.</div>
                    <div class="stat-value text-success">@Model.CurrencySymbol@Model.EstimatedAvailableCash.ToString("N2")</div>
                </div>
                <div class="stat-icon" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
            <div class="text-muted small mt-2">
                Income less expenses & dues
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <!-- 6-Month Income vs Expenses Trend -->
    <div class="col-lg-8">
        <div class="card glass-card border-0 p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0">Monthly Cash Flow Trend (Last 6 Months)</h6>
                <span class="badge bg-light text-muted border">Income vs Outflow</span>
            </div>
            <div style="position: relative; height: 280px; width: 100%;">
                <canvas id="trendChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Expenses by Category Doughnut -->
    <div class="col-lg-4">
        <div class="card glass-card border-0 p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0">Expense by Category</h6>
                <span class="badge bg-light text-muted border">Distribution</span>
            </div>
            @if (Model.CategoryExpenses.Any())
            {
                <div style="position: relative; height: 220px; width: 100%;">
                    <canvas id="categoryChart"></canvas>
                </div>
                <div class="mt-3 overflow-auto" style="max-height: 90px;">
                    @foreach (var cat in Model.CategoryExpenses.Take(4))
                    {
                        <div class="d-flex justify-content-between align-items-center small py-1 border-bottom">
                            <span><span class="category-dot" style="background-color: @cat.ColorHex;"></span>@cat.CategoryName</span>
                            <span class="fw-semibold">@Model.CurrencySymbol@cat.Amount.ToString("N0") (@cat.Percentage%)</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center h-75 text-center text-muted">
                    <i class="bi bi-pie-chart fs-1 mb-2"></i>
                    <span>No confirmed expenses yet for this month.</span>
                </div>
            }
        </div>
    </div>
</div>

<!-- Member Breakdown & Upcoming Bills & Recent Transactions -->
<div class="row g-4 mb-4">
    <!-- Member Spending & Contribution Breakdown -->
    <div class="col-lg-6">
        <div class="card glass-card border-0 p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0">Member Contribution & Spending</h6>
                <a asp-controller="Family" asp-action="Members" class="btn btn-sm btn-link text-decoration-none">Manage Members</a>
            </div>
            @if (Model.MemberExpenses.Any())
            {
                <div class="table-responsive">
                    <table class="table table-custom align-middle">
                        <thead>
                            <tr>
                                <th>Member</th>
                                <th class="text-end">Paid Out</th>
                                <th class="text-end">Income In</th>
                                <th class="text-end">Net Position</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.MemberExpenses)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.75rem;">
                                                @(m.MemberName.Substring(0, 1).ToUpper())
                                            </div>
                                            <span class="fw-semibold">@m.MemberName</span>
                                        </div>
                                    </td>
                                    <td class="text-end text-danger fw-semibold">@Model.CurrencySymbol@m.TotalPaid.ToString("N0")</td>
                                    <td class="text-end text-success fw-semibold">@Model.CurrencySymbol@m.TotalIncomeContributed.ToString("N0")</td>
                                    <td class="text-end fw-bold @(m.NetBalance >= 0 ? "text-success" : "text-danger")">
                                        @Model.CurrencySymbol@m.NetBalance.ToString("N0")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">No member activity recorded yet.</div>
            }
        </div>
    </div>

    <!-- Upcoming Bills Widget -->
    <div class="col-lg-6">
        <div class="card glass-card border-0 p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0">Upcoming Bills & Recurring Dues</h6>
                <a asp-controller="RecurringBills" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">View All Bills</a>
            </div>
            @if (Model.UpcomingBillsList.Any())
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var bill in Model.UpcomingBillsList.Take(4))
                    {
                        <div class="p-3 rounded-3 border d-flex align-items-center justify-content-between @(bill.IsOverdue ? "bg-danger-subtle border-danger" : "bg-surface")">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center @(bill.IsOverdue ? "bg-danger text-white" : "bg-primary-subtle text-primary")" style="width: 40px; height: 40px;">
                                    <i class="bi bi-receipt"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">@bill.BillName</div>
                                    <div class="text-muted small">
                                        Due: <strong class="@(bill.IsOverdue ? "text-danger" : "")">@bill.DueDate.ToString("MMM dd, yyyy")</strong>
                                        @if (bill.IsOverdue)
                                        {
                                            <span class="badge bg-danger ms-1">OVERDUE</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-dark">@Model.CurrencySymbol@bill.Amount.ToString("N2")</div>
                                <a asp-controller="RecurringBills" asp-action="MarkPaid" asp-route-id="@bill.OccurrenceId" class="btn btn-sm btn-outline-primary py-0 px-2 mt-1" style="font-size: 0.75rem;">
                                    Pay Now
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="d-flex flex-column align-items-center justify-content-center py-4 text-center text-muted">
                    <i class="bi bi-check-circle text-success fs-2 mb-2"></i>
                    <span>All bills settled for this cycle!</span>
                </div>
            }
        </div>
    </div>
</div>

<!-- Category Budget Utilization Progress Section -->
@if (Model.BudgetProgressBars.Any())
{
    <div class="card glass-card border-0 mb-4 p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold mb-0">Monthly Category Budget Utilization</h6>
            <a asp-controller="Budgets" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">Budget Targets</a>
        </div>
        <div class="row g-3">
            @foreach (var bar in Model.BudgetProgressBars)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="p-3 border rounded-3 bg-surface">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-semibold small">
                                <span class="category-dot" style="background-color: @bar.ColorHex;"></span>
                                @bar.CategoryName
                            </span>
                            <span class="small fw-bold @(bar.IsOverBudget ? "text-danger" : "text-muted")">
                                @Model.CurrencySymbol@bar.SpentAmount.ToString("N0") / @Model.CurrencySymbol@bar.PlannedAmount.ToString("N0")
                            </span>
                        </div>
                        <div class="progress progress-budget">
                            <div class="progress-bar @(bar.IsOverBudget ? "bg-danger" : (bar.PercentageUsed >= 80 ? "bg-warning" : "bg-primary"))" 
                                 style="width: @Math.Min(100, bar.PercentageUsed)%"></div>
                        </div>
                        <div class="d-flex justify-content-between text-muted mt-1" style="font-size: 0.72rem;">
                            <span>@bar.PercentageUsed% used</span>
                            <span>@(bar.IsOverBudget ? "Exceeded!" : $"Remaining: {Model.CurrencySymbol}{bar.RemainingAmount:N0}")</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Recent Transactions -->
<div class="card glass-card border-0 mb-4">
    <div class="card-header bg-transparent py-3 border-bottom d-flex align-items-center justify-content-between">
        <h6 class="fw-bold mb-0">Recent Household Transactions</h6>
        <div class="d-flex gap-2">
            <a asp-controller="Expenses" asp-action="Index" class="btn btn-sm btn-outline-secondary">All Expenses</a>
            <a asp-controller="Income" asp-action="Index" class="btn btn-sm btn-outline-secondary">All Income</a>
        </div>
    </div>
    @if (Model.RecentTransactions.Any())
    {
        <div class="table-responsive">
            <table class="table table-custom align-middle mb-0">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Member</th>
                        <th>Date</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tx in Model.RecentTransactions)
                    {
                        <tr>
                            <td>
                                @if (tx.Type == "Expense")
                                {
                                    <span class="badge badge-pill-custom badge-expense">
                                        <i class="bi bi-arrow-down-circle"></i> Expense
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-pill-custom badge-income">
                                        <i class="bi bi-arrow-up-circle"></i> Income
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="fw-semibold">@tx.Title</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@tx.CategoryName</span>
                            </td>
                            <td>
                                <span class="text-muted small">@tx.PaidByOrRecipient</span>
                            </td>
                            <td>
                                <span class="text-muted small">@tx.Date.ToString("MMM dd, yyyy")</span>
                            </td>
                            <td class="text-end fw-bold @(tx.Type == "Expense" ? "text-danger" : "text-success")">
                                @(tx.Type == "Expense" ? "-" : "+")@Model.CurrencySymbol@tx.Amount.ToString("N2")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-inbox fs-2 mb-2"></i>
            <div>No transactions recorded for this period.</div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // 1. Monthly Spending Trend Chart
        const trendData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySpendingTrend));
        const trendLabels = trendData.map(d => d.MonthName);
        const trendIncome = trendData.map(d => d.Income);
        const trendExpenses = trendData.map(d => d.Expenses);

        const ctxTrend = document.getElementById('trendChart')?.getContext('2d');
        if (ctxTrend) {
            new Chart(ctxTrend, {
                type: 'bar',
                data: {
                    labels: trendLabels,
                    datasets: [
                        {
                            label: 'Income',
                            data: trendIncome,
                            backgroundColor: 'rgba(16, 185, 129, 0.8)',
                            borderRadius: 6
                        },
                        {
                            label: 'Expenses',
                            data: trendExpenses,
                            backgroundColor: 'rgba(239, 68, 68, 0.8)',
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': ' + '@Model.CurrencySymbol' + Number(context.raw).toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return '@Model.CurrencySymbol' + Number(value).toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
        }

        // 2. Category Breakdown Chart
        const catData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryExpenses));
        const catLabels = catData.map(c => c.CategoryName);
        const catAmounts = catData.map(c => c.Amount);
        const catColors = catData.map(c => c.ColorHex);

        const ctxCat = document.getElementById('categoryChart')?.getContext('2d');
        if (ctxCat && catAmounts.length > 0) {
            new Chart(ctxCat, {
                type: 'doughnut',
                data: {
                    labels: catLabels,
                    datasets: [{
                        data: catAmounts,
                        backgroundColor: catColors,
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': ' + '@Model.CurrencySymbol' + Number(context.raw).toLocaleString();
                                }
                            }
                        }
                    },
                    cutout: '68%'
                }
            });
        }
    </script>
}

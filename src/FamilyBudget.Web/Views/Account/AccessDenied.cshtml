@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center text-center py-5">
    <div class="col-md-6">
        <div class="display-1 text-danger mb-3"><i class="bi bi-shield-lock-fill"></i></div>
        <h2 class="fw-bold">Access Restricted</h2>
        <p class="text-muted">You do not have the required role or permissions within this household to view this resource.</p>
        <div class="mt-4">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary-custom">Return to Dashboard</a>
        </div>
    </div>
</div>

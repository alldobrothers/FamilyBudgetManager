@model FamilyBudget.Web.Models.SettleObligationViewModel
@{
    ViewData["Title"] = "Settle Obligation";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card glass-card border-0 p-4">
            <h4 class="fw-bold mb-1">Settle Obligation</h4>
            <p class="text-muted small mb-4">
                Record settlement for: <strong>@Model.Obligation?.Title</strong>
                @if (Model.Obligation != null)
                {
                    <span class="text-muted">(Outstanding: @Model.CurrencySymbol@Model.Obligation.RemainingBalance.ToString("N2"))</span>
                }
            </p>

            <form asp-action="Settle" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ObligationId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="AmountPaid" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent text-muted">@Model.CurrencySymbol</span>
                            <input asp-for="AmountPaid" type="number" step="0.01" class="form-control" autofocus />
                        </div>
                        <span asp-validation-for="AmountPaid" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SettlementDate" class="form-label"></label>
                        <input asp-for="SettlementDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="SettledByMemberId" class="form-label"></label>
                        <select asp-for="SettledByMemberId" class="form-select">
                            <option value="">-- Household --</option>
                            @foreach (var m in Model.Members)
                            {
                                <option value="@m.Id">@m.User?.FullName</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="form-check form-switch p-3 bg-light rounded-3 border mb-3">
                    <input asp-for="RecordAsExpense" class="form-check-input ms-0 me-2" type="checkbox" id="obExpenseSwitch" />
                    <label class="form-check-label fw-bold" for="obExpenseSwitch">
                        Also record as a household expense outflow
                    </label>
                    <div class="form-text small">Automatically records in monthly expenses and category analytics.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Settlement reference or notes..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary-custom">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="bi bi-check2-circle"></i> Confirm Settlement
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

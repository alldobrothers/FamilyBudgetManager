@model FamilyBudget.Web.Models.CreateObligationViewModel
@{
    ViewData["Title"] = "Add Payment Obligation";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card glass-card border-0 p-4">
            <h4 class="fw-bold mb-1">Add Payment Obligation</h4>
            <p class="text-muted small mb-4">Record a pending household commitment or reimbursement due</p>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-7">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="e.g. Society Maintenance, College Tuition" autofocus />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="AmountDue" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent text-muted">@Model.CurrencySymbol</span>
                            <input asp-for="AmountDue" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="AmountDue" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="PayeeName" class="form-label"></label>
                        <input asp-for="PayeeName" class="form-control" placeholder="e.g. Building Association, Rahul" />
                        <span asp-validation-for="PayeeName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DueDate" class="form-label"></label>
                        <input asp-for="DueDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="ObligationType" class="form-label"></label>
                        <select asp-for="ObligationType" class="form-select">
                            <option value="HouseholdExpense">Household Expense</option>
                            <option value="PersonalDebt">Personal Debt</option>
                            <option value="MemberReimbursement">Member Reimbursement</option>
                            <option value="RecurringBill">Recurring Bill</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Priority" class="form-label"></label>
                        <select asp-for="Priority" class="form-select">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                            <option value="Critical">Critical / Urgent</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ResponsibleMemberId" class="form-label"></label>
                        <select asp-for="ResponsibleMemberId" class="form-select">
                            <option value="">-- Household Shared --</option>
                            @foreach (var m in Model.Members)
                            {
                                <option value="@m.Id">@m.User?.FullName</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Account numbers, remarks..."></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary-custom">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="bi bi-save"></i> Save Obligation
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

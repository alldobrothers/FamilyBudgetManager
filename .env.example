# Family Budget Manager - Environment Configuration Template
# Copy this file to .env or configure in system environment variables

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001

# Database Configuration
# Provider options: Sqlite, SqlServer, PostgreSql
DATABASE_PROVIDER=Sqlite
DATABASE_CONNECTION_STRING=Data Source=FamilyBudget.db;Cache=Shared

# Application Settings
APP_BASE_URL=https://localhost:5001
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹

# Email Delivery Configuration (Optional in development)
EMAIL_PROVIDER=Smtp
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SENDER_EMAIL=noreply@yourfamilydomain.com
SENDER_NAME="Family Budget Manager"

# File Storage Configuration
STORAGE_UPLOAD_PATH=./uploads
STORAGE_MAX_FILE_SIZE_MB=5
